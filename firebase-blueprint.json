      "properties": {
        "groupId": { "type": "string" },
        "classId": { "type": "string" },
        "teacherUid": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string" },
        "senderRole": { "type": "string", "enum": ["GURU", "SISWA"] },
        "pblPhase": { "type": "integer" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "classId", "teacherUid", "senderUid", "senderName", "senderRole", "pblPhase", "message", "createdAt", "updatedAt"]
    },
    "PeerReview": {
      "title": "PeerReview",

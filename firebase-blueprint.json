        "hypothesis": { "type": "string" },
        "scientificEvidence": { "type": "string" },
        "dataAnalysisTable": { "type": "string" },
        "conservationSolution": { "type": "string" },
        "discussionSummary": { "type": "string" },
        "cerClaim": { "type": "string" },
        "cerEvidence": { "type": "string" },
        "cerReasoning": { "type": "string" },
        "campaignCaption": { "type": "string" },
        "attachmentName": { "type": "string" },

  "firestore": {
    "/users/{userId}": { "schema": "UserAccount", "description": "User accounts and roles" },
    "/admins/{userId}": { "schema": "AdminMarker", "description": "Admin role verification markers" },
    "/system_settings/{settingId}": { "schema": "SystemSetting", "description": "Academic year and platform config" },
    "/classes/{classId}": { "schema": "ClassRoom", "description": "Biology classes created by teachers" },
    "/class_codes/{classCode}": { "schema": "ClassCodeLookup", "description": "Join code lookup documents" },
    "/enrollments/{enrollmentId}": { "schema": "Enrollment", "description": "Student class enrollments and progress" },
    "/subjects/{subjectId}": { "schema": "Subject", "description": "Subjects metadata" },
    "/modules/{moduleId}": { "schema": "Module", "description": "Learning modules (Modul 1 & 2)" },
    "/lessons/{lessonId}": { "schema": "Lesson", "description": "Individual biology lessons" },
    "/groups/{groupId}": { "schema": "PblGroup", "description": "PBL collaborative student groups" },
    "/group_discussions/{messageId}": { "schema": "GroupDiscussionMessage", "description": "Real-time PBL group discussion messages" },
    "/peer_reviews/{reviewId}": { "schema": "PeerReview", "description": "Peer assessments of classmate PBL presentations" },
    "/assignments/{assignmentId}": { "schema": "Assignment", "description": "E-LKM and CER campaign assignments" },
    "/submissions/{submissionId}": { "schema": "Submission", "description": "Student and group PBL submissions" },
    "/quizzes/{quizId}": { "schema": "Quiz", "description": "Quizzes and Post-Test evaluations" },
    "/quizzes/{quizId}/answer_keys/{keyDocId}": { "schema": "QuizAnswerKey", "description": "Protected answer keys" },

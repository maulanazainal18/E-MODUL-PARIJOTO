        "evidenceScore": { "type": "integer" },
        "solutionScore": { "type": "integer" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["submissionId", "assignmentId", "classId", "teacherUid", "reviewerUid", "reviewerName", "targetStudentUid", "targetStudentName", "clarityScore", "evidenceScore", "solutionScore", "comment", "createdAt", "updatedAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "PBL E-LKM or CER Digital Campaign assignment.",

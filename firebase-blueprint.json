{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authenticated user profile and RBAC role (ADMIN, GURU, SISWA).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "nama": { "type": "string", "description": "Full display name" },
        "email": { "type": "string", "description": "Google account email" },
        "role": { "type": "string", "enum": ["ADMIN", "GURU", "SISWA"] },
        "accountStatus": { "type": "string", "enum": ["ACTIVE", "SUSPENDED"] },
        "classId": { "type": "string", "description": "Primary joined class ID" },
        "className": { "type": "string", "description": "Primary joined class name" },
        "academicYear": { "type": "string", "description": "Academic year e.g. 2026/2027" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "nama", "email", "role", "accountStatus", "createdAt", "updatedAt"]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted admin privilege marker keyed by UID.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Global platform configuration and academic year settings.",
      "type": "object",
      "properties": {
        "academicYear": { "type": "string" },
        "semester": { "type": "string" },
        "schoolName": { "type": "string" },
        "maintenanceMode": { "type": "boolean" },
        "allowRegistration": { "type": "boolean" },
        "updatedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["academicYear", "semester", "schoolName", "maintenanceMode", "allowRegistration", "updatedBy", "createdAt", "updatedAt"]
    },
    "ClassRoom": {
      "title": "ClassRoom",
      "description": "Biology Class X Fase E managed by a teacher.",
      "type": "object",
      "properties": {
        "teacherUid": { "type": "string" },
        "teacherName": { "type": "string" },
        "name": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "phase": { "type": "string" },
        "classCode": { "type": "string" },
        "academicYear": { "type": "string" },
        "subjectId": { "type": "string" },
        "description": { "type": "string" },
        "archived": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["teacherUid", "teacherName", "name", "gradeLevel", "phase", "classCode", "academicYear", "subjectId", "archived", "createdAt", "updatedAt"]
    },
    "ClassCodeLookup": {
      "title": "ClassCodeLookup",
      "description": "Public code lookup mapping classCode to class metadata for joining.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "teacherUid": { "type": "string" },
        "teacherName": { "type": "string" },
        "gradeLevel": { "type": "string" },
        "academicYear": { "type": "string" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "className", "teacherUid", "teacherName", "gradeLevel", "academicYear", "active", "createdAt", "updatedAt"]
    },
    "Enrollment": {
      "title": "Enrollment",
      "description": "Student membership and progress in a class.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "className": { "type": "string" },
        "classCode": { "type": "string" },
        "teacherUid": { "type": "string" },
        "studentUid": { "type": "string" },
        "studentName": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "REMOVED"] },
        "progressPercent": { "type": "integer" },
        "completedLessons": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "className", "classCode", "teacherUid", "studentUid", "studentName", "status", "progressPercent", "completedLessons", "createdAt", "updatedAt"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Biology subject metadata.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "phase": { "type": "string" },
        "grade": { "type": "string" },
        "academicYear": { "type": "string" },
        "description": { "type": "string" },
        "ownerUid": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "phase", "grade", "academicYear", "ownerUid", "published", "createdAt", "updatedAt"]
    },
    "Module": {
      "title": "Module",
      "description": "Learning module (Modul 1 Etnosains, Modul 2 Konservasi).",
      "type": "object",
      "properties": {
        "subjectId": { "type": "string" },
        "moduleNumber": { "type": "integer" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "meetingLabel": { "type": "string" },
        "durationMinutes": { "type": "integer" },
        "ownerUid": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["subjectId", "moduleNumber", "title", "subtitle", "meetingLabel", "durationMinutes", "ownerUid", "published", "createdAt", "updatedAt"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Individual topic lesson within Modul 1 or Modul 2.",
      "type": "object",
      "properties": {
        "moduleId": { "type": "string" },
        "orderIndex": { "type": "integer" },
        "title": { "type": "string" },
        "learningObjective": { "type": "string" },
        "explanation": { "type": "string" },
        "teenExplanation": { "type": "string" },
        "dailyExample": { "type": "string" },
        "funFact": { "type": "string" },
        "sparkQuestion": { "type": "string" },
        "summary": { "type": "string" },
        "illustrationType": { "type": "string" },
        "citation": { "type": "string" },
        "ownerUid": { "type": "string" },
        "published": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["moduleId", "orderIndex", "title", "learningObjective", "explanation", "summary", "ownerUid", "published", "createdAt", "updatedAt"]
    },
    "PblGroup": {
      "title": "PblGroup",
      "description": "Collaborative Problem Based Learning student group.",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "teacherUid": { "type": "string" },
        "name": { "type": "string" },
        "topic": { "type": "string" },
        "memberUids": { "type": "array" },
        "memberNames": { "type": "array" },
        "memberRoles": { "type": "object" },
        "leaderUid": { "type": "string" },
        "pblPhase": { "type": "integer" },
        "openToJoin": { "type": "boolean" },
        "rootProblem": { "type": "string" },
        "hypothesis": { "type": "string" },
        "investigationNotes": { "type": "string" },
        "conservationStrategy": { "type": "string" },
        "campaignCaption": { "type": "string" },
        "discussionSummary": { "type": "string" },
        "teacherComment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["classId", "teacherUid", "name", "memberUids", "memberNames", "leaderUid", "pblPhase", "openToJoin", "createdAt", "updatedAt"]
    },
    "GroupDiscussionMessage": {
      "title": "GroupDiscussionMessage",
